{
  "name": "babytrack-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BabyTrack AI - pregnancy tracking API (educational assistant, never a diagnosis tool)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node src/server.js",
    "db:reset": "node src/db/reset.js",
    "db:seed": "node src/db/seed.js",
    "check:copy": "node scripts/check-copy.mjs src",
    "test": "node --test \"tests/*.test.js\"",
    "test:api": "node scripts/smoke.mjs",
    "test:bot": "node scripts/smoke-bot.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.77.0"
  }
}
