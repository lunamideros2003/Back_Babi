# Puerto del servidor
PORT=4001
NODE_ENV=development

# Secreto para firmar los JWT (cambiar en produccion)
JWT_SECRET=babytrack-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Origenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5180

# ---------------------------------------------------------------------------
# Base de datos
#
# Opcion 1 (por defecto): SQLite local, un archivo y cero configuracion.
DATABASE_FILE=./data/babytrack.sqlite

# Opcion 2: Supabase o cualquier Postgres. Al poner esta variable el proyecto
# deja de usar el archivo local y se conecta al servidor de base de datos.
# Copia la cadena en Supabase > Project Settings > Database > Connection string.
# Usa el modo "URI" y el pooler "Session" para conexiones cortas y sin limite de duracion.
#
# DATABASE_URL=postgresql://usuario:clave@host:5432/postgres
#
# IMPORTANTE: no agregues ?sslmode=require a la cadena. El codigo ya activa
# TLS para conexiones remotas, y ese parametro lo pisa y rompe la conexion
# contra el pooler de Supabase con "self-signed certificate".
# ---------------------------------------------------------------------------

# Proveedor de IA: auto | openai | local
AI_PROVIDER=auto

# Clave de OpenAI. Sin esta clave el sistema usa el proveedor local por reglas.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.4