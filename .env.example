# Puerto del servidor
PORT=4001
NODE_ENV=development

# Secreto para firmar los JWT (cambiar en produccion)
JWT_SECRET=babytrack-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Origenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5180

# Base de datos SQLite
DATABASE_FILE=./data/babytrack.sqlite

# Proveedor de IA: auto | openai | local
AI_PROVIDER=auto

# Clave de OpenAI. Sin esta clave el sistema usa el proveedor local por reglas.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.4
